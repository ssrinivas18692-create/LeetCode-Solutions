import java.util.*;

public class Main {
    public static void main(String[] args) {
      double[] numbers = {1.5, 2.5, 3.4, 4.6, 5.8, 7.0, 10.5};
      
      for(int i = 0; i < 7; i++){
        System.out.println(numbers[i]);
      }
      System.out.println();
      for(int i = 6; i >= 0; i--){
        System.out.println(numbers[i]);
      }
    }
}
